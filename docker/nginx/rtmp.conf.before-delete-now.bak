# MCGame edge nginx — handles three independent things in one process:
#   stream {} — Layer-4 TCP passthrough for the Flash client RTMPE handshake
#               (the Go server terminates Adobe DH+RC4 itself in
#               pkg/rtmp/handshake/complex.go).
#   http   {} — static asset serving (game SWF tree under /s/, crossdomain.xml
#               for Flash). Replaces the old standalone `frontend` nginx
#               container.
# See docs/research/2026-04-26_01_NGINX_RTMP_HOSTING_RESEARCH.md.

worker_processes      auto;
worker_rlimit_nofile  16384;

events {
    worker_connections 4096;
    multi_accept       on;
}

stream {
    log_format rtmp_basic '$remote_addr [$time_local] '
                          '$protocol $status $bytes_sent $bytes_received '
                          '$session_time "$upstream_addr"';

    access_log /var/log/nginx/rtmp_access.log rtmp_basic;
    error_log  /var/log/nginx/rtmp_error.log  warn;

    # 127.0.0.11 is Docker's embedded DNS. Resolving on demand (rather than
    # via a static `upstream { server ... }` block) means nginx survives a
    # mcgame-server restart without needing its own restart.
    resolver 127.0.0.11 valid=10s ipv6=off;

    server {
        listen 1935;

        set $mcgame_backend "mcgame-server:1935";
        proxy_pass            $mcgame_backend;

        proxy_protocol        on;
        proxy_connect_timeout 5s;
        proxy_timeout         10m;
        tcp_nodelay           on;
    }
}

http {
    resolver 127.0.0.11 valid=10s ipv6=off;
    limit_req_zone $binary_remote_addr zone=registration:1m rate=5r/m;
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile           on;
    sendfile_max_chunk 512k;
    tcp_nopush         on;
    tcp_nodelay        on;

    # Long-lived keepalive to cloudflared / ngrok / direct clients.
    # Flash loads many small assets in parallel; without this, each request
    # would open a fresh TCP/TLS — and intermittent connect failures show up
    # as 502 at the upstream tunnel.
    keepalive_timeout  120s;
    keepalive_requests 10000;

    client_body_timeout    30s;
    client_header_timeout  30s;
    send_timeout           60s;

    # Cache file descriptors so repeated SWF / image lookups skip stat().
    open_file_cache          max=10000 inactive=60s;
    open_file_cache_valid    60s;
    open_file_cache_min_uses 2;
    open_file_cache_errors   on;

    gzip               on;
    gzip_vary          on;
    gzip_min_length    1024;
    gzip_comp_level    5;
    gzip_proxied       any;
    gzip_types         text/plain text/xml text/css application/xml application/json application/javascript image/svg+xml;

    access_log /var/log/nginx/http_access.log;
    error_log  /var/log/nginx/http_error.log warn;

    # Cache long for immutable game assets, no-cache for dynamic-ish ones.
    map $request_uri $asset_expires {
        ~*\.(swf|jpg|jpeg|png|gif|ico|css|js|woff2?|ttf|eot)$  30d;
        default                                                   off;
    }

    server {
        listen 80 default_server;
        # h2c (HTTP/2 cleartext) so cloudflared can multiplex hundreds of
        # parallel /s/res/* requests over a single origin TCP connection
        # instead of saturating its HTTP/1.1 pool. Requires originRequest:
        # http2Origin: true on the cloudflared side.
        http2 on;

        server_name _;
        root /usr/share/nginx/html;

        location = /register.html {
            limit_except GET { deny all; }
            add_header Cache-Control "no-store" always;
            add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Referrer-Policy "no-referrer" always;
            try_files /register.html =404;
        }

        location = /registration/form.js {
            limit_except GET { deny all; }
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
            try_files $uri =404;
        }

        location = /registration/style.css {
            limit_except GET { deny all; }
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
            try_files $uri =404;
        }

        location /registration/ { return 404; }

        location = /api/register {
            default_type application/json;
            if ($request_uri !~ "^/api/register([?].*)?$") { return 400 '{"code":"invalid_input","message":"Đường dẫn đăng ký không hợp lệ."}'; }
            if ($request_method != POST) { return 405 '{"code":"method_not_allowed","message":"Chỉ hỗ trợ POST."}'; }
            limit_req zone=registration burst=3 nodelay;
            limit_req_status 429;
            client_max_body_size 4k;
            client_body_timeout 10s;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Allow "POST" always;
            set $registration_backend "mcgame-server:8081";
            proxy_pass http://$registration_backend;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Forwarded "";
            proxy_connect_timeout 3s;
            proxy_read_timeout 15s;
            proxy_send_timeout 10s;
            proxy_intercept_errors on;
            error_page 429 = @registration_throttled;
            error_page 413 = @registration_invalid;
            error_page 502 503 504 = @registration_unavailable;
        }

        location @registration_invalid {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
            return 400 '{"code":"invalid_input","message":"Dữ liệu không hợp lệ hoặc vượt quá 4 KiB."}';
        }

        location @registration_throttled {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Retry-After "12" always;
            return 429 '{"code":"rate_limited","message":"Quá nhiều yêu cầu. Chờ ít nhất 12 giây rồi thử lại; người dùng chung IP VPN chia sẻ giới hạn."}';
        }

        location @registration_unavailable {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
            return 503 '{"code":"unavailable","message":"Chưa thể đăng ký. Vui lòng thử lại sau."}';
        }

        # Flash needs crossdomain.xml at the host root for cross-origin
        # NetConnection / NetStream from arbitrary domains.
        location = /crossdomain.xml {
            add_header Access-Control-Allow-Origin "*" always;
            try_files /crossdomain.xml =404;
        }

        # Resource directory: content-hash named files, treat as immutable.
        # Cloudflare's edge will cache and serve future hits without ever
        # touching origin, which kills the burst-load 502 source.
        location /s/res/ {
            expires    1y;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            try_files  $uri =404;
        }

        location /s/sv/res/ {
            expires    1y;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            rewrite ^/s/sv/res/(.*)$ /s/res/$1 break;
            try_files  $uri =404;
        }

        location /s/ {
            expires       $asset_expires;
            add_header    Cache-Control "public" always;
            try_files     $uri $uri/ =404;
        }

        location / {
            try_files $uri $uri/ =404;
        }
    }
}
